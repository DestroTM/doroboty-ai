# PostHog browser analytics (public values: the project token is designed to ship in the browser bundle).
# Production builds (`npm run build`, Netlify, the production check) read .env.production.
# `npm run dev` has no analytics; copy these lines to .env.local only to test analytics locally,
# ideally with a separate PostHog project.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
